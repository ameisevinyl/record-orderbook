# Build output — generated by `node build/build.js`, not source.
# Deployed to GitHub Pages via CI (see .github/workflows/ci.yml), so it
# doesn't need to live in the repo. If you'd rather commit it (e.g. to
# hand someone a direct file link without waiting on Pages), delete
# this line.
/dist/

# Real plant identity (imprint/transfer config) — never committed, see
# src/plant.config.local.example.js for the template. Without this
# file, both dev mode and any build run without it show the safe
# sample data from config.js instead.
/src/plant.config.local.js

# OS/editor noise
.DS_Store
*.swp
